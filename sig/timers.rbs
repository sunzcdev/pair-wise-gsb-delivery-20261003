module HTTPX
  class Timers
    type callback = ^() -> void

    @intervals: Array[Interval]

    def after: (interval interval_in_secs, ^() -> void) -> Timer
             | (interval interval_in_secs) { () -> void } -> Timer

    # returns the remaining time until the next deadline, or nil when empty
    def wait_interval: () -> interval?

    def fire: (?TimeoutError error) -> void

    def initialize: () -> void

    def empty?: () -> bool

    private

    def prune!: () -> void

    class Interval
      include Comparable

      attr_reader interval: interval

      @callbacks: Array[callback]
      @deadline: Float?

      def to_f: () -> Float

      def <<: (callback) -> void

      def delete: (callback) -> void

      def elapse: () -> void

      def due?: (?Numeric now) -> bool

      def time_left: (?Numeric now) -> Numeric

      def no_callbacks?: () -> bool

      private

      def initialize: (interval interval) -> void
    end

    class Timer
      @interval: Interval
      @callback: callback
      @cancelled: bool

      attr_accessor label: Symbol?

      def initialize: (Interval interval, callback callback) -> void

      def cancel: () -> void

      def cancelled?: () -> bool
    end
  end
end