module HTTPX
  module Plugins
    module ServerSentEvents
      def self.load_dependencies: (singleton(Session)) -> void

      def self.subplugins: () -> Hash[Symbol, Module]

      class Message
        attr_reader data: String
        attr_reader id: _ToS?
        attr_reader event: _ToS?
        attr_reader retry_after: Integer?

        def initialize: (data: String, ?event: _ToS?, ?id: _ToS?, ?retry_after: Integer?) -> void
      end

      interface _ServerSentEventsOptions
        def event_stream: () -> boolish

        def last_event_id: () -> String?
      end

      module InstanceMethods
        @options: Options & _ServerSentEventsOptions

        def build_request: (*untyped) -> request
      end

      module RequestMethods
        attr_accessor last_server_sent_message: Message?
        attr_accessor last_server_sent_event_id: String?
        attr_accessor last_server_sent_retry: String?
      end

      module StreamResponseMethods
        def each_message: () { (Message) -> void } -> void
                 | () -> Enumerable[Message]

        def last_event_id: () -> String?

        def reset_message_parsing: () -> void

        private

        def shift_message_line: () -> String?

        def dispatch: (Hash[Symbol, String]) -> Message?

        def to_text: (String?) -> String?

        def parse_line: (String line, Hash[Symbol, String] payload) -> void
      end

      module ServerSentEventsRetries
        module InstanceMethods
          private

          def prepare_to_retry: (Request, untyped) -> void

          def when_to_retry: (Request, untyped) -> (Float | nil)
        end
      end
    end

    type sessionServerSentEvents = Session & ServerSentEvents::InstanceMethods
  end
end