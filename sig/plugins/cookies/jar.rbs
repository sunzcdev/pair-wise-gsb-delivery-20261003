module HTTPX
  module Plugins::Cookies
    class Jar
      type cookie = Cookie | Array[[String, String, cookie_attributes]] | Array[[String, String]] | cookie_attributes

      include Enumerable[Cookie]

      @cookies: Array[[untyped, Cookie]]
      @mtx: Thread::Mutex
      @current_partition: Array[untyped]

      def partition_key: () -> untyped

      def partition_key=: (untyped partition_key) -> untyped

      def parse: (String set_cookie) -> void

      def get: (String | cookie_attributes name_or_options) -> Cookie?

      def get_all: (String | cookie_attributes name_or_options) -> Array[Cookie]

      def set: (_ToS | Cookie name, ?(cookie_attributes | _ToS) value_or_options) -> void

      def add: (Cookie name, ?String path) -> void

      def delete: (String | Cookie | cookie_attributes name_or_options) -> void

      def clear: () -> void

      def []: (http_uri) -> Array[Cookie]

      def each: (?http_uri?) { (Cookie) -> void } -> void
              | (?http_uri?) -> Enumerable[Cookie]

      def merge: (_Each[cookie] | Jar cookies) -> self

      protected

      def each_stored: () { (untyped, Cookie) -> void } -> void

      private

      def initialize: (?_Each[cookie] cookies, ?partition_key: untyped) -> untyped

      def to_cookie: (untyped elem) -> Cookie

      def store: (untyped partition_key, Cookie cookie) -> void

      def synchronize: [T] { () -> T } -> T
    end
  end
end