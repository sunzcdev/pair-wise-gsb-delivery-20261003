
module HTTPX
  module Plugins
    module GRPC
      module Message
        def self?.unary: (response) -> String

        def self?.stream: (StreamResponse | response) { (String) -> void } -> void
                        | (StreamResponse | response) -> Enumerable[String]

        def self?.cancel: (Request) -> void

        def self?.verify_status: (StreamResponse | response) -> void
      end
    end
  end
end