module HTTPX
  module Plugins
    module Callbacks
      CALLBACKS: Array[Symbol]
      REQUEST_CALLBACKS: Array[Symbol]
      REQUEST_CALLBACK_EVENTS: Hash[Symbol, Symbol]

      class CallbackError < Exception
      end

      module InstanceMethods
        include HTTPX::Callbacks

        type socket = TCPSocket | OpenSSL::SSL::SSLSocket | UNIXSocket

        def on_connection_opened: () { (http_uri origin, socket sock) -> void } -> self

        def on_connection_closed: () { (http_uri origin) -> void } -> self

        def on_request_error: () { (Request request, StandardError error) -> void } -> self

        def on_request_started: () { (Request request) -> void } -> self

        def on_request_body_chunk: () { (Request request, String chunk) -> void } -> self

        def on_request_completed: () { (Request request) -> void } -> self

        def on_response_started: () { (Request request, Response response) -> void } -> self

        def on_response_body_chunk: () { (Request request, Response response, String chunk) -> void } -> self

        def on_response_completed: () { (Request request, response response) -> void } -> self

        private

        def set_request_callbacks: (Request request) -> void

        def emit_or_callback_error: (Symbol type, *untyped) -> void

        def emit_on_request: (Symbol type, *untyped) -> void
      end

      module RequestMethods
        def on_request_error: (?local: bool) { (Request request, StandardError error) -> void } -> self

        def on_request_started: (?local: bool) { (Request request) -> void } -> self

        def on_request_body_chunk: (?local: bool) { (Request request, String chunk) -> void } -> self

        def on_request_completed: (?local: bool) { (Request request) -> void } -> self

        def on_response_started: (?local: bool) { (Request request, Response response) -> void } -> self

        def on_response_body_chunk: (?local: bool) { (Request request, Response response, String chunk) -> void } -> self

        def on_response_completed: (?local: bool) { (Request request, response response) -> void } -> self
      end

      module ConnectionMethods
      end
    end

    type sessionCallbacks = Session & Callbacks::InstanceMethods
  end
end
