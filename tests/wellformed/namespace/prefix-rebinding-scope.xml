<!--
Description:  entry-scoped prefix rebinding does not leak into sibling entries
Expect:       not bozo and entries[0]['itunes_block'] == 1 and entries[1]['x_block'] == 'no' and 'itunes_block' not in entries[1] and entries[2]['itunes_block'] == 1
-->
<feed xmlns="http://www.w3.org/2005/Atom">
  <entry xmlns:x="http://www.itunes.com/DTDs/Podcast-1.0.dtd">
    <x:block>yes</x:block>
  </entry>
  <entry xmlns:x="http://example.com/other">
    <x:block>no</x:block>
  </entry>
  <entry xmlns:itunes="http://www.itunes.com/DTDs/Podcast-1.0.dtd">
    <itunes:block>yes</itunes:block>
  </entry>
</feed>
